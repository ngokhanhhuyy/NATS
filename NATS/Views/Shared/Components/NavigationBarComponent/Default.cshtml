@inject CssUniqueIdHelper IdGenerator
@using Microsoft.AspNetCore.Components;
@using NATS.Public.Controllers;
@model NavigationBarViewModel
@{
    UniqueId = IdGenerator.GenerateId();
}

@functions {
    private string UniqueId { get; set; }

    private string CurrentControllerName
    {
        get => ViewContext.RouteData.Values["controller"]?.ToString();
    }

    private string CurrentActionName => ViewContext.RouteData.Values["action"]?.ToString();

    private string ClassName
    {
        get
        {
            if (!Context.Request.Path.StartsWithSegments("/quan-tri")) {
                return "shadow";
            }

            return "border-bottom border-success-subtle";
        }
    }

    private List<(string, string, string)> Items
    {
        get
        {
            string currentPath = Context.Request.Path;
            if (currentPath.StartsWith("/quan-tri"))
            {
                return new List<(string, string, string)>
                {
                    (Url.GetProtectedDashboardRoutePath(), "Dashboard", "Bảng điều khiển"),
                };
            }

            return new List<(string, string, string)>
            {
                (Url.GetPublicSummaryItemListRoutePath(), "SummaryItem", "Giới thiệu"),
                (
                    Url.GetPublicAboutUsIntroductionRoutePath(),
                    "AboutUsIntroduction",
                    "Về chúng tôi"
                ),
                (Url.GetPublicServiceListRoutePath(), "Services", "Dịch vụ"),
                (Url.GetPublicCourseListRoutePath(), "Course", "Khoá học"),
                (Url.GetPublicEnquiryRoutePath(), "Contact", "Liên hệ")
            };
        }
    }

    private string ComputeNavBarItemClassName(string key)
    {
        string catalogItemControllerName;
        catalogItemControllerName = nameof(CatalogItemController).Replace("Controller", "");
        if (CurrentControllerName == catalogItemControllerName &&
            CurrentActionName.Replace("List", "").Replace("Detail", "") == key)
        {
            return "active";
        }

        if (CurrentControllerName == key)
        {
            return "active";
        }

        return string.Empty;
    }
}

@if (CurrentControllerName != "Authentication")
{
    <nav
        class="navbar navbar-expand-xl fixed-top fs-5 py-0 @ClassName"
        id="navbar"
        data-bs-theme="light"
    >
        <div class="container-fluid">
            <!-- Main logo -->
            <a
                href="@Url.GetPublicHomeRoutePath()"
                class="navbar-brand d-flex align-items-center"
            >
                <img
                    src="/images/main-logo-transparent-white-without-text-small.png"
                    class="me-2 flex-shrink-0"
                    alt="@Model.GeneralSettings.ApplicationName"
                />
                <span class="fs-2 application-short-name">
                    @Model.GeneralSettings.ApplicationShortName
                </span>
            </a>
            
            <button
                class="navbar-toggler fs-3 me-2 py-2"
                id="navbar-toggler-button"
                type="button"
                data-bs-toggle="offcanvas"
                data-bs-target="#navbar-content"
                aria-controls="navbar-content"
                aria-expanded="false"
                aria-label="Toggle navigation"
            >
                <i class="bi bi-list"></i>
            </button>
            
            <div
                class="offcanvas offcanvas-end"
                tabindex="-1"
                id="navbar-content"
                aria-labelledby="offcanvasNavbarLabel"
            >
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title" id="offcanvasNavbarLabel">Điều hướng</h5>
                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="offcanvas"
                        aria-label="Close">
                    </button>
                </div>
                <div class="offcanvas-body">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 justify-content-end w-100">
                        <!-- Home -->
                        <li class="nav-item">
                            <a
                                href="@Url.GetPublicHomeRoutePath()"
                                class="nav-link @ComputeNavBarItemClassName("Home")"
                            >
                                Trang chủ
                            </a>
                        </li>

                        @for (int index = 0; index < Items.Count; index++)
                        {
                            (string Url, string Key, string Text) item;
                            item = Items[index];

                            <li class="nav-item">
                                <a
                                    href="@item.Url"
                                    class="nav-link @ComputeNavBarItemClassName(item.Key)"
                                >
                                    @item.Text
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </nav>
}