@using NATS.Helpers
@inject CssUniqueIdHelper CssUniqueId
@model IHasThumbnailUpsertViewModel
@{
    string uniqueId = CssUniqueId.GenerateId();
}

<div class="thumbnail-input-container" data-unique-id="@uniqueId">
    <div class="click-area"></div>
    <input type="file" class="d-none" accept="image/png, image/jpeg, image/jpg">
    <input type="hidden">
        
    </template>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const querySelector = `.thumbnail-input-element[data-unique-id=\"${@uniqueId}\"]`;
        const clickAreaElement = document.querySelector(querySelector);
    });
</script>