@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid flex-fill d-flex flex-column w-100">
    <div class="body-container flex-fill">
        @RenderBody()
    </div>
</div>


@section PageTitle {
    @await RenderSectionAsync("PageTitle", required: true)
}

@section Styles {
    <link href="/css/protected/protected.css" rel="stylesheet" asp-append-version="@true" />
    @await RenderSectionAsync("Styles", required: false)
}

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}