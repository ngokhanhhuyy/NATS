@model EnquiryViewModel
@{
    Layout = "_SubPagesLayout";
}

<div class="container-fluid py-5" id="enquiry-view">
    <div class="container">
        <div class="row gx-5 gy-4 justify-content-center my-5">
            <div class="col col-xxl-5 col-xl-6 col-lg-7 col-md-8 col-12">
                <div class="bg-success text-white d-flex flex-column p-4 pt-3
                            rounded-top-4 shadow">
                    <div class="fs-2">Bạn cần tư vấn?</div>
                    <span>Hãy gửi câu hỏi cho chúng tôi</span>
                    <span class="opacity-75">
                        * Chúng tôi sẽ không chia sẻ thông tin của bạn.
                    </span>
                </div>
                <form
                    asp-area="FrontPages"
                    asp-controller="Enquiry"
                    asp-action="Create"
                    method="post"
                    class="bg-white rounded-4 rounded-top-0 shadow p-3 w-100
                            border border-top-0 border-success d-flex
                            flex-column align-items-stretch shadow"
                >
                    <!-- FullName -->
                    <div class="form-group mb-3">
                        <div class="form-floating required">
                            <input
                                asp-for="FullName"
                                type="text"
                                placeholder=""
                                maxlength="50"/>
                            <label class="required" asp-for="FullName">Họ và tên</label>
                        </div>
                        <span asp-validation-for="FullName"></span>
                    </div>

                    <!-- PhoneNumber -->
                    <div class="form-group mb-3">
                        <div class="form-floating required">
                            <input
                                asp-for="PhoneNumber"
                                type="tel"
                                placeholder=""
                                maxlength="15"/>
                            <label class="required" asp-for="PhoneNumber">
                                Số điện thoại
                            </label>
                        </div>
                        <span asp-validation-for="PhoneNumber"></span>
                    </div>

                    <!-- Email -->
                    <div class="form-group mb-3">
                        <div class="form-floating">
                            <input
                                asp-for="Email"
                                type="email"
                                placeholder=""
                                maxlength="255"/>
                            <label asp-for="Email">
                                Địa chỉ email
                            </label>
                        </div>
                        <span asp-validation-for="Email"></span>
                    </div>

                    <!-- Content -->
                    <div class="form-group mb-3">
                        <div class="form-floating required">
                            <textarea
                                asp-for="Content"
                                style="min-height: 200px"
                                placeholder=""
                            ></textarea>
                            <label class="required" asp-for="Content">
                                Nội dung
                            </label>
                        </div>
                        <span asp-validation-for="Content"></span>
                    </div>

                    <!-- Submit -->
                    <button class="btn btn-outline-success align-self-end" type="submit">
                        Gửi
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section PageTitle {
    Gửi câu hỏi
}

@section Title {
    Gửi câu hỏi
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const formElement = document.querySelector("#enquiry-view form");
            if (formElement) {
                formElement.scrollIntoView({ behavior: "smooth", block: "center" });
            }
        });
    </script>
}
