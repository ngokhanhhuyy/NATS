@model SummaryItemListViewModel
@functions {
    private string ComputeThumbnailColumnClassName(int index)
    {
        return $"order-lg-{index % 2}";
    }

    private string ComputeDetailColumnClassName(int index)
    {
        return $"order-lg-{(index + 1) % 2}";
    }

    private string ComputeNameClassName(int index)
    {
        string className = "text-center";
        if (index % 2 == 0)
        {
            className += " text-lg-start";
        }
        else
        {
            className += " text-lg-end";
        }

        return className;
    }
}

<div class="container p-4 mt-4" id="summary-item-view">
    @for (int index = 0; index < Model.Items.Count; index++)
    {
        SummaryItemDetailModel item = Model.Items[index];
        <div class="row g-5 justify-content-center mb-5 item-row" id="summary-item-@item.Id">
            <!-- Thumbnail -->
            <div
                class="col col-lg-auto col-md-11 col-12 d-flex justify-content-center
                        align-items-start @ComputeThumbnailColumnClassName(index)"
            >
                <img
                    src="@item.ThumbnailUrl"
                    class="rounded-circle shadow"
                    alt="@item.Name"
                />
            </div>

            <div class="col col-lg col-md-10 col-12 @ComputeDetailColumnClassName(index)">
                <!-- Name -->
                <div class="fs-2 text-success @ComputeNameClassName(index) mb-3">
                    @item.Name
                </div>

                <!-- DetailContent -->
                @{
                    string[] paragraphs = item.DetailContent.Split(Environment.NewLine);
                    foreach (string paragraph in paragraphs)
                    {
                        <p>@paragraph</p>
                    }
                }
            </div>
        </div>
    }
</div>

@section PageTitle {
    Giới thiệu
}

@section Title {
    Giới thiệu
}

@section Styles {
    <style>
        #summary-item-view img {
            width: 250px;
            height: auto;
            aspect-ratio: 1;
            object-fit: cover;
            object-position: 50%;
        }
        
        .item-row {
            border-radius: 1rem;
            border: 1px solid transparent;
            scroll-margin-top: 2rem;
        }
        
        .item-row[id="summary-item-@Model.FocusedId"] {
            transform-origin: 50% 50%;
            animation-name: focus-animation;
            animation-iteration-count: 5;
            animation-duration: .5s;
        }
        
        @@keyframes focus-animation {
            0% {
                transform: scale(100%);
            }
            
            50% {
                transform: scale(102%);
            }
            
            100% {
                transform: scale(100%);
            }
        }
    </style>
}

@section Scripts {
    @if (Model.FocusedId.HasValue)
    {
        bool doesFocusedIdExist = Model.Items
            .Select(i => i.Id)
            .Contains(Model.FocusedId.Value);
        if (doesFocusedIdExist)
        {
            
            <script>
                document.addEventListener("DOMContentLoaded", () => {
                    const /** @@type {HTMLDivElement} */ itemElement = document
                        .getElementById("summary-item-@Model.FocusedId");
                    itemElement.scrollIntoView({ behavior: "smooth", block: "start" });
                });
            </script>
        }
    }
}