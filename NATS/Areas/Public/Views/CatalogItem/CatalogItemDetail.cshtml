@model CatalogItemDetailViewModel
@{
    List<CatalogItemBasicModel> otherItems = Model.OtherCatalogItems
        .OrderBy(_ => Guid.NewGuid())
        .Take(4)
        .ToList();
}

<div class="container-fluid p-0" id="catalog-item-detail-view">
    <div class="container p-4">
        <div class="row g-4 justify-content-center">
            <!-- Name and summary -->
            <div class="col col-md-10 col-12">
                <!-- Name --> 
                <h2 class="text-success">
                    @Model.Name
                </h2>

                <!-- Summary -->
                <span class="d-inline-block my-2">@Model.Summary</span>
            </div>

            <!-- Thumbnail -->
            <div class="col col-xl-4 col-md-5 col-10">
                @if (Model.ThumbnailUrl != null)
                {
                    <img
                        src="@Model.ThumbnailUrl"
                        class="w-100 img-thumbnail rounded-4 shadow"
                        alt="@Model.Name"
                    />
                }
            </div>

            <!-- Detail -->
            <div class="col col-sm-10 col-12 pt-4">
                @Html.Raw(Model.Detail)
            </div>
        </div>
    </div>

    <!-- EnquiryLink -->
    <div class="container-fluid py-5 bg-success text-white mt-5">
        <div class="container d-flex flex-column justify-content-center align-items-center">
            <span class="fs-1 text-center">
                Hãy để chúng tôi tư vấn cho bạn!
            </span>
            <a href="#" class="btn btn-outline-light btn-lg mt-3">
                Liên hệ
            </a>
        </div>
    </div>

    <!-- OtherItems -->
    <div class="container my-5">
        <div class="row g-4 justify-content-center align-items-stretch">
            <div class="col col-md-10 col-12 fs-2 text-success">
                @DisplayNames.Get(Model.Type.ToString()) khác
            </div>
            
            @foreach (var catalogItem in otherItems)
            {
                <div class="col col-xl-3 col-sm-5 col-10">
                    <div class="card w-100 h-100">
                        <img
                            src="@catalogItem.ThumbnailUrl"
                            class="card-img-top"
                            alt="@catalogItem.Name"
                        />
                        <div class="card-body d-flex flex-column justify-content-start">
                            <!-- Name -->
                            <h5 class="card-title text-success">
                                @catalogItem.Name
                            </h5>

                            <!-- Summary -->
                            <div class="card-text d-block flex-fill">
                                @catalogItem.Summary
                            </div>

                            <!-- DetailLink -->

                            @{
                                var item = catalogItem;
                            }
                            <a
                                asp-area="FrontPages"
                                asp-controller="CatalogItem"
                                asp-action="@(catalogItem.Type.ToString() + "Detail")"
                                asp-route-id="@item.Id"
                                class="btn btn-outline-success align-self-end mt-3"
                            >
                                Chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section PageTitle {
    @Model.Name
}

@section Title {
    @Model.Name
}