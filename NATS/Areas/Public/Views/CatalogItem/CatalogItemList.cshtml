@model CatalogItemListViewModel
@functions {
    private string ComputeTitle()
    {
        return DisplayNames.Get(Model.Type.ToString());
    }

    private string ComputeThumbnailUrl(CatalogItemBasicModel catalogItem)
    {
        if (catalogItem.Type == CatalogItemType.Course)
        {
            return "https://placehold.co/400";
        }

        return catalogItem.ThumbnailUrl;
    }
}

@if (Model.Items.Count > 0)
{
    <div class="container h-100" id="catalog-item-list-view">
        <div class="row g-3 px-3 py-4 catalog-items-row">
            @foreach (CatalogItemBasicModel catalogItem in Model.Items)
            {
                <div class="col col-xl-3 col-lg-4 col-md-6 col-sm-10 col-10
                            justify-self-md-start justify-self-sm-center">
                    <div class="card h-100 shadow-sm">
                        <!-- Thumbnail -->
                        <img
                            src="@ComputeThumbnailUrl(catalogItem)"
                            class="card-img-top catalog-item-thumbnail"
                            alt="@catalogItem.Name"
                        />

                        <div class="card-body d-flex flex-column flex-fill
                                    justify-content-between align-items-start">
                            <!-- Title -->
                            <a
                                asp-area="Public"
                                asp-controller="CatalogItem"
                                asp-action="@(catalogItem.Type.ToString() + "Detail")"
                                asp-route-id="@catalogItem.Id"
                                class="card-title fs-5"
                            >
                                @catalogItem.Name
                            </a>

                            <!-- Summary -->
                            <span>@catalogItem.Summary</span>

                            <!-- LinkToDetail -->
                            <a
                                asp-area="Public"
                                asp-controller="CatalogItem"
                                asp-action="@(catalogItem.Type.ToString() + "Detail")"
                                asp-route-id="@catalogItem.Id"
                                class="btn btn-outline-success mt-2"
                            >
                                Chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="d-flex justify-content-center align-items-center p-5 m-5 fs-5">
        <span class="opacity-75">Không có @ComputeTitle().ToLower() nào</span>
    </div>
}

@section PageTitle {
    @ComputeTitle()
}

@section Title {
    @ComputeTitle()
}

@section Styles {
    <style>
        #catalog-item-list-view .card-title {
            color: var(--bs-success);
            font-weight: bold;
            text-decoration: none;
        }
        
        @@media (max-width: 768px) {
            #catalog-item-list-view .catalog-items-row.row {
                width: fit-content !important;
                justify-content: center;
            }
        }
        
        @@media (max-width: 576px) {
            #catalog-item-list-view .catalog-items-row.row {
                width: 100%;
            }
        }
    </style>
}