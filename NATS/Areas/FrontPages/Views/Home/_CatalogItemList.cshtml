@model List<CatalogItemBasicModel>
@functions {
    private Random random = new Random();

    private string ComputeTitle()
    {
        if (Model.Count == 0)
        {
            return string.Empty;
        }

        CatalogItemType type = Model[0].Type;
        return DisplayNames.Get(type.ToString().ToLower());
    }

    private string ComputeThumbnailUrl(CatalogItemBasicModel catalogItem)
    {
        if (catalogItem.Type == CatalogItemType.Course)
        {
            return "https://placehold.co/400";
        }

        return catalogItem.ThumbnailUrl;
    }
}

<div class="row g-4 align-items-stretch mt-5 catalog-items-row">
    <div class="col col-12 fs-2 text-success text-center mb-2">
        @ComputeTitle()
    </div>

    @foreach (CatalogItemBasicModel catalogItem in Model)
    {
        <div class="col col-xl-3 col-lg-4 col-md-6 col-sm-10 col-10
                    justify-self-md-start justify-self-sm-center">
            <div class="card h-100 shadow-sm">
                <img
                    src="@ComputeThumbnailUrl(catalogItem)"
                    class="card-img-top catalog-item-thumbnail"
                    alt="@catalogItem.Name"
                />

                <div class="card-body d-flex flex-column flex-fill
                            justify-content-between align-items-start">
                    <h5 class="card-title">
                        @catalogItem.Name
                    </h5>

                    <a href="#" class="btn btn-outline-success mt-2">Chi tiết</a>
                </div>
            </div>
        </div>
    }
</div>