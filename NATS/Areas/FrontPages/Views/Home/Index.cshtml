@model HomeViewModel
@{
    Layout = "_Layout";
}

<div class="container-fluid p-0" id="home-view">
    <!-- SliderItems -->
    <partial name="_SliderItemList" model="Model.SliderItems" />

    <!-- ApplicationName -->
    <div
        class="container-fluid text-center text-white fw-bold p-2 mb-3 shadow"
        id="application-name-container"
    >
        @Model.GeneralSettings.ApplicationName
    </div>

    <!-- SummaryItems -->
    <div class="container">
        <div class="row g-3 p-3">
            @foreach (SummaryItemDetailModel summaryItem in Model.SummaryItems)
            {
                <a
                    asp-area="FrontPages"
                    asp-controller="SummaryItem"
                    asp-action="Index"
                    asp-route-focusedItemIndex="@summaryItem.Id"
                    class="col col-xl-3 col-md-6 col-12 p-3 summary-item-link
                            d-flex flex-column align-items-center"
                >
                    <img
                        class="rounded-circle summary-item-thumbnail mb-3 shadow"
                        src="@summaryItem.ThumbnailUrl"
                        alt="@summaryItem.Name"
                    >

                    <span class="fs-3 text-center text-success mb-3">
                        @summaryItem.Name
                    </span>

                    <p>@summaryItem.SummaryContent</p>
                </a>
            }
        </div>
    </div>

    <!-- AboutUsIntroduction -->
    <div class="container-fluid bg-success text-white fs-5 shadow p-0">
        <div class="container p-0">
            <div class="row g-0 p-3 justify-content-center align-items-stretch">
                <div class="col col-xl-6 col-lg-8 col-12 d-flex align-items-start m-3">
                    <img
                        src="@Model.AboutUsIntroduction.ThumbnailUrl"
                        class="w-100 rounded-3"
                        alt="Về chúng tôi"
                    />
                </div>
                
                <div class="col-xl col-lg-8 col d-flex flex-column
                            justify-content-center align-items-start m-3">
                    <div class="fs-2 mb-3">Về chúng tôi</div>
                    <p>@Model.AboutUsIntroduction.AboutUsContent</p>
                    <a
                        asp-area="FrontPages"
                        asp-controller="AboutUs"
                        asp-action="Index"
                        class="btn btn-outline-light mt-3"
                    >
                        Tìm hiểu thêm
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- CatalogItems -->
    <div class="container mt-3" id="catalog-item-container">
        <partial name="_CatalogItemList" model="Model.Services" />
        <partial name="_CatalogItemList" model="Model.Courses" />
        <partial name="_CatalogItemList" model="Model.Products" />
    </div>

    <!-- Enquiry -->
    <partial name="_EnquiryForm" model="new EnquiryViewModel()" />
</div>

@section PageTitle {
    Trang chủ
}

@section Styles {
    <style>
        #home-view .carousel-background {
            --blur-radius: 25px;
            background: rgba(var(--bs-success-rgb), 0.5);
            position: absolute;
            top: 50%;
            left: 50%;
            width: calc(100% + var(--blur-radius) * 4);
            height: calc(100% + var(--blur-radius) * 4);
            transform: translate(-50%, -50%);
            filter: blur(var(--blur-radius));
            transition: opacity 1s ease;
        }
    
        #home-view .carousel-background::after {
            content: "";
            background: rgba(var(--bs-success-rgb), 0.5);
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0;
        }
    
        #home-view #carousel-container {
            width: 100%;
            max-width: 1400px;
            margin: auto;
        }
    
        #home-view #slider {
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.25);
        }
    
        #home-view .carousel-img {
            max-height: 750px;
            object-fit: cover;
        }
    
        #home-view #application-name-container {
            background-color: rgb(20, 112, 70);
            font-size: 1.4em;
        }
        
        #home-view .summary-item-link {
            color: unset;
            text-decoration: none;
            cursor: pointer;
        }
    
        #home-view .summary-item-thumbnail {
            width: 150px;
            height: 150px;
            aspect-ratio: 1;
        }
    
        #home-view .catalog-item-thumbnail {
            width: 100%;
            aspect-ratio: 1;
            object-fit: cover;
            object-position: 50% 50%;
        }
    
        #home-view textarea {
            min-height: 200px;
        }
    
        #home-view button[type="submit"]:hover {
            color: white !important;
        }
    
        @@media (max-width: 768px) {
            #home-view .catalog-items-row.row {
                width: fit-content !important;
                justify-content: center;
            }
        }
    
        @@media (max-width: 576px) {
            #home-view .company-name {
                font-size: 1.0em;
            }
    
            #home-view .catalog-items-row.row {
                width: 100%;
            }
        }
    </style>
}