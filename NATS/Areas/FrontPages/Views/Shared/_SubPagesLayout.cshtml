@{
    Layout = "_Layout";
}

<div
    class="container-fluid bg-success-subtle text-white border-bottom border-success p-5"
    id="sub-page-top"
>
    <div class="container p-3">
        <span class="fs-1">
            @await RenderSectionAsync("Title", required: true)
        </span>
    </div>
</div>

@RenderBody()

@section PageTitle {
    @await RenderSectionAsync("PageTitle", required: true)
}

@section Styles {
    @await RenderSectionAsync("Styles", required: false)
}

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}