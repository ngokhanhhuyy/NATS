@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Navigation Bar -->
@await Component.InvokeAsync("NavigationBarComponent")

<!-- MainContent -->
<main class="flex-fill h-100 fade-animation fade-animation-reverse">
    @RenderBody()
</main>

<!-- Footer -->
@await Component.InvokeAsync("FooterComponent")

@section PageTitle {
    @await RenderSectionAsync("PageTitle", required: true)
}

@section Styles {
    <link rel="stylesheet" href="/css/front-pages/front-pages.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
}

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}