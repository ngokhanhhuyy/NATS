@model EnquiryViewModel

<div class="container-fluid bg-success" id="enquiry-form">
    <div class="row justify-content-center p-4 pb-5">
        <div class="col col-xxl-4 col-xl-5 col-lg-6 col-md-7 col-12">
            <div class="mb-3 text-white fs-5 d-flex flex-column">
                <div class="fs-2">Bạn cần tư vấn?</div>
                <span>Hãy gửi câu hỏi cho chúng tôi</span>
                <span class="small opacity-75">
                    * Chúng tôi sẽ không chia sẻ thông tin của bạn.
                </span>
            </div>
            
            <form
                asp-area="FrontPages"
                asp-controller="Enquiry"
                asp-action="Create"
                method="post"
                class="bg-white rounded-4 shadow p-3 w-100
                        d-flex flex-column align-items-stretch"
            >
                <!-- FullName -->
                <div class="form-group mb-3">
                    <div class="form-floating required">
                        <input
                            asp-for="FullName"
                            type="text"
                            placeholder=""
                            maxlength="50"
                        />
                        <label class="required" asp-for="FullName">Họ và tên</label>
                    </div>
                </div>

                <!-- PhoneNumber -->
                <div class="form-group mb-3">
                    <div class="form-floating required">
                        <input
                            asp-for="PhoneNumber"
                            type="tel"
                            placeholder=""
                            maxlength="15"
                        />
                        <label class="required" asp-for="PhoneNumber">Số điện thoại</label>
                    </div>
                </div>

                <!-- Email -->
                <div class="form-group mb-3">
                    <div class="form-floating">
                        <input
                            asp-for="Email"
                            type="email"
                            placeholder=""
                            maxlength="255"
                        />
                        <label asp-for="Email">Địa chỉ email</label>
                    </div>
                </div>

                <!-- Content -->
                <div class="form-group mb-3">
                    <div class="form-floating required">
                        <textarea
                            asp-for="Content"
                            style="min-height: 200px"
                            placeholder=""
                        ></textarea>
                        <label class="required" asp-for="Content">Nội dung</label>
                    </div>
                </div>

                <!-- Submit -->
                <button
                    type="submit"
                    class="btn btn-outline-success text-success align-self-end"
                >
                    Gửi
                </button>
            </form>
        </div>
    </div>
</div>