@model AboutUsIntroductionContentPartialViewModel

<div class="col col-lg-6 col-md-10 col-12">
    <h2 class="text-success text-center fw-normal mb-3">
        @Model.Title
    </h2>
    
    @{
        string[] whyChooseUsParagraphs = Model.Content
            .Split(Environment.NewLine)
            .ToArray();

        foreach (string paragraph in whyChooseUsParagraphs)
        {
            <p>@paragraph</p>
        }
    }
</div>