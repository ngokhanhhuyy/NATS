@model AboutUsIntroductionViewModel
@{
    AboutUsIntroductionContentPartialViewModel mainContentModel;
    mainContentModel = new AboutUsIntroductionContentPartialViewModel
    {
        Title = DisplayNames.AboutUs,
        Content = Model.AboutUsIntroduction.AboutUsContent
    };
    
    AboutUsIntroductionContentPartialViewModel whyChooseUsContent;
    whyChooseUsContent = new AboutUsIntroductionContentPartialViewModel
    {
        Title = DisplayNames.WhyChooseUs,
        Content = Model.AboutUsIntroduction.WhyChooseUsContent
    };
    
    AboutUsIntroductionContentPartialViewModel ourDifferenceModel;
    ourDifferenceModel = new AboutUsIntroductionContentPartialViewModel
    {
        Title = DisplayNames.OurDifference,
        Content = Model.AboutUsIntroduction.OurDifferenceContent
    };
    
    AboutUsIntroductionContentPartialViewModel ourCultureModel;
    ourCultureModel = new AboutUsIntroductionContentPartialViewModel
    {
        Title = DisplayNames.OurCulture,
        Content = Model.AboutUsIntroduction.OurCultureContent
    };
}

<div class="container p-4" id="about-us-view">
    <!-- Thumbnail -->
    <div class="row justify-content-center px-3 py-3 mb-4">
        <div class="col col-xl-6 col-lg-7 col-md-8 col-12 order-lg-0 order-1">
            <img
                src="@Model.AboutUsIntroduction.ThumbnailUrl"
                class="w-100 rounded-4 shadow"
                alt="Về chúng tôi"
            />
        </div>
    </div>
    
    
	<div class="row gx-5 gy-3 px-5 py-3 justify-content-center">
        <!-- MainContent -->
        <partial name="_Content" model="mainContentModel" />

        <!-- WhyChooseUsContent -->
        <partial name="_Content" model="whyChooseUsContent" />

        <!-- OurDifferenceContent --> 
        <partial name="_Content" model="ourDifferenceModel" />

        <!-- OurCultureContent --> 
        <partial name="_Content" model="ourCultureModel" />
    </div>

    <!-- Members -->
    <div class="row gx-5 gy-3 justify-content-center mt-2">
        <div class="col col-lg-12 col-md-10 col-12">
            <h2 class="text-success text-center fw-normal">
                Đội ngũ của chúng tôi
            </h2>
        </div>
        
        @foreach (var member in Model.Members)
        {
            <div class="col col-xl-5 col-lg-6 col-md-8 col-sm-10 col-12
                        d-flex flex-column align-items-center">
                <img
                    src="@member.ThumbnailUrl"
                    class="member-thumbnail rounded-circle shadow flex-shrink-0 mb-3"
                    alt="@member.FullName"
                />

                <!-- FullName -->
                <span class="fs-4 fw-bold bg-success-subtle border
                            border-success-subtle rounded
                            text-success px-2 text-success">
                    @member.FullName
                </span>

                <!-- RoleName -->
                <span class="my-2 text-success">
                    @member.RoleName
                </span>

                <!-- Description -->
                @{
                    string[] descriptionParagraphs = member
                        .Description
                        .Split(Environment.NewLine)
                        .ToArray();

                    foreach (string paragraph in descriptionParagraphs)
                    {
                        <p>@paragraph</p>
                    }
                } 
            </div>
        }
    </div>

    <!-- Certificates -->
    <div class="row gx-5 gy-3 justify-content-center my-2">
        <div class="col col-md-10 col-12">
            <h2 class="text-success text-center fw-normal">
                Chứng chỉ
            </h2>
        </div>
        @foreach (CertificateDetailModel certificate in Model.Certificates)
        {
            <div class="col col-xl-5 col-md-10 col-12">
                <div class="d-flex flex-column justify-content-stretch
                            align-items-stretch rounded-4 shadow overflow-hidden">
                    <img src="@certificate.ThumbnailUrl" alt="@certificate.Name" />
                    <div class="bg-success p-3 text-center text-white fs-5 fw-bold">
                        @certificate.Name
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section PageTitle {
    Về chúng tôi
}

@section Title {
    Về chúng tôi
}

@section Styles {
    <style>
        #about-us-view .member-thumbnail {
            width: 150px;
            height: auto;
            aspect-ratio: 1;
        }
    </style>
}