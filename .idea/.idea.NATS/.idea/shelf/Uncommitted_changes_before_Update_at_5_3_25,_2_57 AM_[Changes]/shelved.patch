<+>.thumbnail-input-container {\r\n    --transition-duration: .15s;\r\n    --transition-timing-function: ease;\r\n    background-color: rgba(var(--bs-secondary-rgb), 0.1);\r\n    color: var(--bs-secondary);\r\n    border: 1px solid rgba(var(--bs-secondary-rgb), 0.25);\r\n    border-radius: .5rem;\r\n    padding: 1rem;\r\n    min-height: 120px;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    transition:\r\n        background var(--transition-duration) var(--transition-timing-function),\r\n        border var(--transition-duration) var(--transition-timing-function),\r\n        color var(--transition-duration) var(--transition-timing-function);\r\n}\r\n\r\n.thumbnail-input-container:not(:has(.thumbnail-adding-indicator.d-none)):hover {\r\n    color: var(--bs-success);\r\n    background: rgba(var(--bs-success-rgb), 0.1);\r\n    border-color: rgba(var(--bs-success-rgb), 0.5);\r\n}\r\n\r\n.click-area {\r\n    opacity: 0;\r\n    position: absolute;\r\n    top: 0;\r\n    width: 100%;\r\n    height: 100%;\r\n    cursor: pointer;\r\n}\r\n\r\n.thumbnail-preview {\r\n    width: 150px;\r\n    height: 150px;\r\n    position: relative;\r\n}\r\n\r\n.thumbnail-preview img {\r\n    width: 100%;\r\n    height: 100%;\r\n    object-fit: cover;\r\n    object-position: 50%;\r\n    border-color: rgba(var(--bs-success-rgb), 0.5) !important;\r\n    box-shadow: var(--bs-box-shadow-sm);\r\n}\r\n\r\n.thumbnail-preview button {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    padding: .25rem;\r\n    aspect-ratio: 1;\r\n    position: absolute;\r\n    top: 0;\r\n    right: 0;\r\n    transform: scale(125%) translate(25%, -25%) rotate(-45deg);\r\n    box-shadow: var(--bs-box-shadow-sm);\r\n}\r\n\r\n.thumbnail-adding-indicator {\r\n    font-weight: bold;\r\n    font-size: 1rem;\r\n}
