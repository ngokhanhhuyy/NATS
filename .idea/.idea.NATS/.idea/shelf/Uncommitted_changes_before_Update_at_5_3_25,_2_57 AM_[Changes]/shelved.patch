<+>@using NATS.Helpers\r\n@inject CssUniqueIdHelper CssUniqueId\r\n@model IHasThumbnailUpsertViewModel\r\n@{\r\n    string imgbbApiKey = Environment.GetEnvironmentVariable(\"IMGBB_API_KEY\");\r\n    string uniqueId = CssUniqueId.GenerateId();\r\n    string defaultImageUrl = \"https://i.ibb.co/R4pCSvP3/default.jpg\";\r\n}\r\n@functions {\r\n    private bool HasThumbnail => !string.IsNullOrWhiteSpace(Model.ThumbnailUrl);\r\n    private string ThumbnailPreviewClassName => !HasThumbnail ? \"d-none\" : \"\";\r\n    private string ThumbnailAddingIndicatorClassName => HasThumbnail ? \"d-none\" : \"\";\r\n}\r\n\r\n<div class=\"thumbnail-input-container\" data-unique-id=\"@uniqueId\">\r\n    <button type=\"button\" class=\"click-area\"></button>\r\n    <input type=\"file\" class=\"d-none\" accept=\"image/png, image/jpeg, image/jpg\">\r\n    <input type=\"hidden\">\r\n    \r\n    <!-- Thumbnail Preview -->\r\n    <div class=\"thumbnail-preview @ThumbnailPreviewClassName\">\r\n        <img src=\"@(Model.ThumbnailUrl ?? defaultImageUrl)\" class=\"img-thumbnail\" />\r\n        <button type=\"button\" class=\"btn btn-danger rounded-circle delete-button\">\r\n            +\r\n        </button>\r\n    </div>\r\n    \r\n    <!-- Thumbnail Adding Indicator -->\r\n    <div class=\"thumbnail-adding-indicator @ThumbnailAddingIndicatorClassName\">\r\n        <span>Thêm ảnh</span>\r\n        <i class=\"bi bi-plus-lg\"></i>\r\n    </div>\r\n    \r\n    <!-- Thumbnail Loading Indicator -->\r\n    <div class=\"thumbnail-loading-indicator d-none\">\r\n        <span class=\"spinner-border spinner-border-sm\" aria-hidden=\"true\"></span>\r\n        <span role=\"status\">Đang xử lý ...</span>\r\n    </div>\r\n    \r\n    <!-- Validation Modal -->\r\n    <div\r\n        class=\"modal fade\"\r\n        data-bs-backdrop=\"static\"\r\n        data-bs-keyboard=\"false\"\r\n        tabindex=\"-1\"\r\n        aria-hidden=\"true\"\r\n    >\r\n        <div class=\"modal-dialog\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <h1 class=\"modal-title fs-5\"></h1>\r\n                    <button\r\n                        type=\"button\"\r\n                        class=\"btn-close\"\r\n                        data-bs-dismiss=\"modal\"\r\n                        aria-label=\"Close\"\r\n                    ></button>\r\n                </div>\r\n                <div class=\"modal-body d-flex flex-column\">\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    <button\r\n                        type=\"button\"\r\n                        class=\"btn btn-secondary\"\r\n                        data-bs-dismiss=\"modal\"\r\n                    >\r\n                        Đã hiểu\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n<script src=\"/js/protected/thumbnail_input.js\"></script>\r\n<script>\r\ndocument.addEventListener(\"DOMContentLoaded\", () => {\r\n    const imgbbApiKey = \"@imgbbApiKey\";\r\n    const querySelector = \".thumbnail-input-container[data-unique-id=\\\"@uniqueId\\\"]\";\r\n    createThumbnailInputController(imgbbApiKey, querySelector);\r\n});\r\n</script>
